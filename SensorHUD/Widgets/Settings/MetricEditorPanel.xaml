<UserControl
    x:Class="SensorHUD.Widgets.Settings.MetricEditorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewModels="using:SensorHUD.Widgets.Settings"
    Visibility="Collapsed">

    <UserControl.Resources>
        <Storyboard x:Name="OpenStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="Overlay"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="TranslateY"
                From="14"
                To="0"
                Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="ScaleX"
                From="0.985"
                To="1"
                Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="ScaleY"
                From="0.985"
                To="1"
                Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="CloseStoryboard" Completed="CloseStoryboard_Completed">
            <DoubleAnimation
                Storyboard.TargetName="Overlay"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="TranslateY"
                From="0"
                To="8"
                Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="ScaleX"
                From="1"
                To="0.99"
                Duration="0:0:0.12" />
            <DoubleAnimation
                Storyboard.TargetName="PanelTransform"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="0.99"
                Duration="0:0:0.12" />
        </Storyboard>
    </UserControl.Resources>

    <!--
        Xbox Game Bar's hosted XAML surface does not reliably support complex
        UWP flyouts. This in-widget layer provides the same compact editing
        workflow without creating another popup or window.
    -->
    <Grid
        x:Name="Overlay"
        Background="#99000000"
        KeyDown="Overlay_KeyDown">
        <Border
            MaxWidth="520"
            Margin="16"
            Padding="0"
            RenderTransformOrigin="0.5,0.5"
            Style="{StaticResource SettingsSurfaceStyle}">
            <Border.RenderTransform>
                <CompositeTransform x:Name="PanelTransform" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="18,18,18,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SettingsAccentSubtleBrush}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource SettingsAccentBrush}"
                            Glyph="&#xE9D9;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="3">
                        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="DescriptionText" Style="{StaticResource SectionDescriptionStyle}" />
                    </StackPanel>
                    <Button
                        x:Name="CloseButton"
                        Grid.Column="2"
                        Width="36"
                        Height="36"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Close metric settings"
                        Click="CloseButton_Click"
                        CornerRadius="6">
                        <FontIcon FontSize="13" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                    <ItemsControl x:Name="MetricItems" Margin="18,0,18,18">
                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="True" />
                            </TransitionCollection>
                        </ItemsControl.ItemContainerTransitions>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:MetricSettingsViewModel">
                                <Border Margin="0,0,0,10" Style="{StaticResource MetricEditorCardStyle}">
                                    <StackPanel Spacing="8">
                                        <ToggleSwitch
                                            Header="{x:Bind Name}"
                                            IsOn="{x:Bind IsVisible, Mode=TwoWay}"
                                            OffContent="Off"
                                            OnContent="On" />
                                        <TextBox Header="Format" Text="{x:Bind Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Description>
                                                <TextBlock Margin="0,4,0,0" Text="{x:Bind UnitDescription}" />
                                            </TextBox.Description>
                                        </TextBox>
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            Header="Decimals"
                                            ItemsSource="{x:Bind DecimalOptions}"
                                            SelectedItem="{x:Bind SelectedDecimals, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:DecimalOption">
                                                    <TextBlock Text="{x:Bind Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind ColorSettings, Mode=OneTime}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:MetricColorSettingViewModel">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                                            <TextBlock FontWeight="Medium" Text="{x:Bind Label}" />
                                                            <TextBlock
                                                                FontSize="13"
                                                                Foreground="{ThemeResource SettingsMutedForegroundBrush}"
                                                                Text="{x:Bind Description}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button
                                                            Grid.Column="1"
                                                            Padding="10,7"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="{x:Bind AutomationName}"
                                                            CornerRadius="6">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border
                                                                    Width="22"
                                                                    Height="22"
                                                                    Background="{x:Bind ColorBrush, Mode=OneWay}"
                                                                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5" />
                                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind ColorText, Mode=OneWay}" />
                                                            </StackPanel>
                                                            <Button.Flyout>
                                                                <Flyout Placement="Bottom">
                                                                    <StackPanel Spacing="8">
                                                                        <muxc:ColorPicker
                                                                            MinWidth="280"
                                                                            MaxWidth="320"
                                                                            IsAlphaEnabled="True"
                                                                            IsAlphaTextInputVisible="False"
                                                                            IsColorChannelTextInputVisible="False"
                                                                            IsHexInputVisible="False"
                                                                            IsMoreButtonVisible="False"
                                                                            Color="{x:Bind Color, Mode=TwoWay}" />
                                                                        <TextBox
                                                                            Header="Hex"
                                                                            MaxLength="9"
                                                                            PlaceholderText="#AARRGGBB"
                                                                            Text="{x:Bind ColorText, Mode=TwoWay}" />
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
