<Page
    x:Class="SensorHUD.Widgets.Settings.SettingsWidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:SensorHUD.Widgets.Settings">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760"
                        Padding="{StaticResource SettingsPagePadding}"
                        Spacing="16"
                        HorizontalAlignment="Stretch">

                <!-- Header -->
                <Border Padding="20" CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF6FC8FF" Offset="0" />
                            <GradientStop Color="#FF3A5BFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="SENSORHUD"
                                       Foreground="#CCFFFFFF"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       CharacterSpacing="120" />
                            <TextBlock Text="Make the overlay yours"
                                       Foreground="White"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Margin="16,0,0,0"
                                Width="48"
                                Height="48"
                                CornerRadius="12"
                                Background="#26FFFFFF">
                            <FontIcon Glyph="&#xE9D9;"
                                      FontSize="23"
                                      Foreground="White" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Collector status -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Collector status"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Live status from the protected data collector."
                                       Style="{StaticResource SectionDescriptionStyle}" />
                        </StackPanel>
                        <Grid ColumnSpacing="16" RowSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.35*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Collector"
                                       Style="{StaticResource StatusLabelStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Status.Connection, Mode=OneWay}"
                                       Style="{StaticResource StatusValueStyle}" />
                            <TextBlock Grid.Row="1" Text="Last snapshot"
                                       Style="{StaticResource StatusLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{x:Bind ViewModel.Status.LastSnapshot, Mode=OneWay}"
                                       Style="{StaticResource StatusValueStyle}" />
                            <TextBlock Grid.Row="2" Text="Administrator"
                                       Style="{StaticResource StatusLabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{x:Bind ViewModel.Status.Administrator, Mode=OneWay}"
                                       Style="{StaticResource StatusValueStyle}" />
                            <TextBlock Grid.Row="3" Text="PawnIO"
                                       Style="{StaticResource StatusLabelStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{x:Bind ViewModel.Status.PawnIo, Mode=OneWay}"
                                       Style="{StaticResource StatusValueStyle}" />
                            <TextBlock Grid.Row="4" Text="Frame metrics"
                                       Style="{StaticResource StatusLabelStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{x:Bind ViewModel.Status.Frames, Mode=OneWay}"
                                       Style="{StaticResource StatusValueStyle}" />
                            <TextBlock Grid.Row="5" Text="Processor"
                                       Style="{StaticResource StatusLabelStyle}" />
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       Text="{x:Bind ViewModel.Status.Processor, Mode=OneWay}"
                                       Style="{StaticResource StatusValueStyle}" />
                            <TextBlock Grid.Row="6" Text="Graphics"
                                       Style="{StaticResource StatusLabelStyle}" />
                            <TextBlock Grid.Row="6" Grid.Column="1"
                                       Text="{x:Bind ViewModel.Status.Graphics, Mode=OneWay}"
                                       Style="{StaticResource StatusValueStyle}" />
                        </Grid>
                        <Border Padding="12"
                                CornerRadius="8"
                                Background="#26E5484D"
                                Visibility="{x:Bind ViewModel.Status.ErrorVisibility, Mode=OneWay}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Latest collector error"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFF8B8F" />
                                <TextBlock Text="{x:Bind ViewModel.Status.Error, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Opacity="0.85" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Display -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="13">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Display"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Control layout, background, and typography."
                                       Style="{StaticResource SectionDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox Header="Layout"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.Layout.Options, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.Layout.Layout, Mode=TwoWay}" />
                        <TextBox Header="Horizontal separator"
                                 CornerRadius="4"
                                 Description="Spacing is added automatically. Leave empty for a single space."
                                 Text="{x:Bind ViewModel.Layout.HorizontalSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="{x:Bind ViewModel.Appearance.MinimumBackgroundOpacityPercent, Mode=OneTime}"
                                    Maximum="{x:Bind ViewModel.Appearance.MaximumBackgroundOpacityPercent, Mode=OneTime}"
                                    Header="Background opacity"
                                    StepFrequency="1"
                                    CornerRadius="4"
                                    Value="{x:Bind ViewModel.Appearance.BackgroundOpacityPercent, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Appearance.BackgroundOpacityText, Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <TextBox Header="Font family"
                                 CornerRadius="4"
                                 PlaceholderText="Segoe UI"
                                 Text="{x:Bind ViewModel.Appearance.FontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Spacing="4">
                            <ComboBox Header="Font weight"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="4"
                                      ItemsSource="{x:Bind ViewModel.Appearance.FontWeightOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.Appearance.FontWeight, Mode=TwoWay}" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="{x:Bind ViewModel.Appearance.MinimumFontSize, Mode=OneTime}"
                                    Maximum="{x:Bind ViewModel.Appearance.MaximumFontSize, Mode=OneTime}"
                                    Header="Font size"
                                    StepFrequency="1"
                                    CornerRadius="4"
                                    Value="{x:Bind ViewModel.Appearance.FontSize, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Appearance.FontSizeText, Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Font color"
                                           FontWeight="Medium" />
                                <TextBlock
                                    Text="Choose the overlay text color."
                                    Style="{StaticResource ControlDescriptionStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Padding="10,7"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <Border Width="22"
                                            Height="22"
                                            CornerRadius="5"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                            Background="{x:Bind ViewModel.Appearance.FontColorBrush, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Appearance.FontColorText, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout
                                        Placement="Bottom"
                                        FlyoutPresenterStyle="{StaticResource ColorPickerFlyoutPresenterStyle}">
                                        <ColorPicker
                                            CornerRadius="4"
                                            MinWidth="280"
                                            MaxWidth="320"
                                            Color="{x:Bind ViewModel.Appearance.FontColor, Mode=TwoWay}"
                                            IsAlphaEnabled="True"
                                            IsColorChannelTextInputVisible="False"
                                            IsAlphaTextInputVisible="False"
                                            IsHexInputVisible="False"
                                            IsMoreButtonVisible="False" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Metrics -->
                <StackPanel Margin="2,4,2,0" Spacing="4">
                    <TextBlock Text="Metrics"
                               FontSize="23"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Customize visibility, precision, and templates. Available tokens: {value}, {unit}, {name}, and {device}."
                               Style="{StaticResource SectionDescriptionStyle}" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.MetricGroups, Mode=OneTime}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MetricGroupViewModel">
                            <Border Margin="0,0,0,14"
                                    Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind MetricCountText}"
                                                   FontSize="12"
                                                   Opacity="0.58"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind Metrics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:MetricSettingsViewModel">
                                                <Border Margin="0,0,0,8"
                                                        Style="{StaticResource MetricEditorCardStyle}">
                                                    <StackPanel Spacing="8">
                                                        <ToggleSwitch Header="{x:Bind Name}"
                                                                      IsOn="{x:Bind IsVisible, Mode=TwoWay}"
                                                                      OnContent="On"
                                                                      OffContent="Off" />
                                                        <TextBox Header="Template"
                                                                 CornerRadius="4"
                                                                 Text="{x:Bind Template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Description="{x:Bind UnitDescription}" />
                                                        <ComboBox Header="Decimal precision"
                                                                  CornerRadius="4"
                                                                  ItemsSource="{x:Bind PrecisionOptions}"
                                                                  SelectedItem="{x:Bind SelectedPrecision, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="viewModels:PrecisionOption">
                                                                    <TextBlock Text="{x:Bind Label}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Reset -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Reset settings"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Restore all display and metric defaults."
                                       Style="{StaticResource SectionDescriptionStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Reset"
                                CornerRadius="4"
                                Click="ResetButton_Click"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="About SensorHUD"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneTime}"
                                   Opacity="0.72" />
                        <TextBlock Text="A customizable local PC telemetry overlay for Xbox Game Bar."
                                   Style="{StaticResource SectionDescriptionStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CopyrightText, Mode=OneTime}"
                                   Style="{StaticResource SectionDescriptionStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
