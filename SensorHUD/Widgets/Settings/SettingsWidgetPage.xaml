<Page
    x:Class="SensorHUD.Widgets.Settings.SettingsWidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewModels="using:SensorHUD.Widgets.Settings"
    Background="{ThemeResource SettingsPageBackgroundBrush}">

    <Grid>
        <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="760"
                Padding="20,20,20,28"
                Spacing="16">

                <!--  Header  -->
                <Border Padding="20" CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#FF60CDFF" />
                            <GradientStop Offset="1" Color="#FF3A5BFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock
                                CharacterSpacing="120"
                                FontSize="26"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="SensorHUD" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#CCFFFFFF"
                                Text="Make the overlay yours."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Width="48"
                            Height="48"
                            Margin="16,0,0,0"
                            Background="#26FFFFFF"
                            CornerRadius="12">
                            <FontIcon
                                FontSize="23"
                                Foreground="White"
                                Glyph="&#xE9D9;" />
                        </Border>
                    </Grid>
                </Border>

                <!--  Collector status  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Collector status" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Live status from the protected data collector." />
                        </StackPanel>
                        <Grid ColumnSpacing="16" RowSpacing="9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.35*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StatusLabelStyle}" Text="Collector" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource StatusValueStyle}"
                                Text="{x:Bind ViewModel.Status.Connection, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource StatusLabelStyle}"
                                Text="Last snapshot" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource StatusValueStyle}"
                                Text="{x:Bind ViewModel.Status.LastSnapshot, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource StatusLabelStyle}"
                                Text="Administrator" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource StatusValueStyle}"
                                Text="{x:Bind ViewModel.Status.Administrator, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="3"
                                Style="{StaticResource StatusLabelStyle}"
                                Text="PawnIO" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="1"
                                Style="{StaticResource StatusValueStyle}"
                                Text="{x:Bind ViewModel.Status.PawnIo, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="4"
                                Style="{StaticResource StatusLabelStyle}"
                                Text="Frame capture" />
                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="1"
                                Style="{StaticResource StatusValueStyle}"
                                Text="{x:Bind ViewModel.Status.FrameCapture, Mode=OneWay}" />
                        </Grid>
                        <muxc:InfoBar
                            Title="Collector needs attention"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.Status.HasError, Mode=OneWay}"
                            Message="{x:Bind ViewModel.Status.Error, Mode=OneWay}"
                            Severity="Error" />
                    </StackPanel>
                </Border>

                <!--  Display  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="13">
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Display" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Control layout, background, and typography." />
                        </StackPanel>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="Layout"
                            ItemsSource="{x:Bind ViewModel.Layout.DirectionOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.Layout.Direction, Mode=TwoWay}" />
                        <TextBox
                            Description="Spacing is added automatically. Leave empty for a single space."
                            Header="Horizontal separator"
                            Text="{x:Bind ViewModel.Layout.HorizontalSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Slider
                            Header="Background opacity"
                            Maximum="{x:Bind ViewModel.Appearance.MaximumBackgroundOpacityPercent, Mode=OneTime}"
                            Minimum="{x:Bind ViewModel.Appearance.MinimumBackgroundOpacityPercent, Mode=OneTime}"
                            StepFrequency="1"
                            Value="{x:Bind ViewModel.Appearance.BackgroundOpacityPercent, Mode=TwoWay}" />
                        <TextBox
                            Header="Font family"
                            PlaceholderText="Segoe UI"
                            Text="{x:Bind ViewModel.Appearance.FontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="Font weight"
                            ItemsSource="{x:Bind ViewModel.Appearance.FontWeightOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.Appearance.FontWeight, Mode=TwoWay}" />
                        <Slider
                            Header="Font size"
                            Maximum="{x:Bind ViewModel.Appearance.MaximumFontSize, Mode=OneTime}"
                            Minimum="{x:Bind ViewModel.Appearance.MinimumFontSize, Mode=OneTime}"
                            StepFrequency="1"
                            Value="{x:Bind ViewModel.Appearance.FontSize, Mode=TwoWay}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                Header="Horizontal text alignment"
                                ItemsSource="{x:Bind ViewModel.Appearance.HorizontalTextAlignmentOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.Appearance.HorizontalTextAlignment, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="Vertical text alignment"
                                ItemsSource="{x:Bind ViewModel.Appearance.VerticalTextAlignmentOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.Appearance.VerticalTextAlignment, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Metrics  -->
                <StackPanel Margin="2,4,2,0" Spacing="4">
                    <TextBlock
                        FontSize="23"
                        FontWeight="SemiBold"
                        Text="Metrics" />
                    <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Open a category to customize its metrics. Available tokens: {value}, {unit}, {name}, and {device}." />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.MetricCategories, Mode=OneTime}">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="True" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MetricCategoryViewModel">
                            <Border Margin="0,0,0,14" Style="{StaticResource SectionCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Bind Name}" />
                                        <TextBlock
                                            Style="{StaticResource SectionDescriptionStyle}"
                                            Text="{x:Bind Description}"
                                            Visibility="{x:Bind DescriptionVisibility}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Padding="12,8"
                                        VerticalAlignment="Center"
                                        AutomationProperties.HelpText="Open metric settings"
                                        AutomationProperties.Name="{x:Bind Name}"
                                        Click="MetricCategoryButton_Click"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind MetricCountText}" />
                                            <FontIcon FontSize="12" Glyph="&#xE72A;" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Reset  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Reset settings" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Restore all display and metric defaults." />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="ResetButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE777;" />
                                <TextBlock Text="Reset" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!--  About  -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="About SensorHUD" />
                            <TextBlock
                                Opacity="0.72"
                                Text="{x:Bind ViewModel.VersionText, Mode=OneTime}" />
                            <TextBlock
                                x:Name="UpdateStatusText"
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="A customizable local PC telemetry overlay for Xbox Game Bar." />
                            <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="{x:Bind ViewModel.CopyrightText, Mode=OneTime}" />
                        </StackPanel>
                        <Button
                            x:Name="CheckForUpdatesButton"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Click="CheckForUpdatesButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE895;" />
                                <TextBlock Text="Check for updates" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <viewModels:MetricEditorPanel
            x:Name="MetricEditor"
            Closed="MetricEditor_Closed"
            Opened="MetricEditor_Opened" />
    </Grid>
</Page>
