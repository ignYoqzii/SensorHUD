<Page
    x:Class="SensorHUD.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush"
                    Value="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="Background"
                    Value="Transparent" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20" Spacing="12">
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Layout"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <ComboBox x:Name="LayoutBox"
                                  Header="Direction"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Vertical" />
                            <ComboBoxItem Content="Horizontal" />
                        </ComboBox>
                        <TextBox x:Name="HorizontalSeparatorBox"
                                 Header="Horizontal Separator"
                                 Description="Spacing is added automatically. Leave empty for a single space."
                                 TextChanged="Setting_TextChanged" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Appearance"
                                   FontSize="19"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="Background Opacity" FontWeight="SemiBold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OpacitySlider"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="1"
                                    ValueChanged="OpacitySlider_ValueChanged" />
                            <TextBlock x:Name="OpacityValue"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBox x:Name="FontFamilyBox"
                                 Header="Font family"
                                 PlaceholderText="Segoe UI"
                                 TextChanged="Setting_TextChanged" />

                        <ComboBox x:Name="FontWeightBox"
                                  Header="Font weight"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="Setting_Changed">
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Normal" />
                            <ComboBoxItem Content="SemiBold" />
                            <ComboBoxItem Content="Bold" />
                            <ComboBoxItem Content="Black" />
                        </ComboBox>

                        <TextBlock Text="Font size" FontWeight="SemiBold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="FontSizeSlider"
                                    Minimum="8"
                                    Maximum="48"
                                    StepFrequency="1"
                                    ValueChanged="FontSizeSlider_ValueChanged" />
                            <TextBlock x:Name="FontSizeValue"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBox x:Name="FontColorBox"
                                 Header="Font color"
                                 PlaceholderText="#FFFFFFFF"
                                 Description="Use #RRGGBB or #AARRGGBB."
                                 TextChanged="Setting_TextChanged" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock Text="Displayed Metrics"
                               FontSize="21"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Each hardware section controls what is shown and how it is formatted. Available tokens: {value}, {unit}, {name}, and {device}."
                               Opacity="0.72"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- One card is generated for frame rate, CPU, every GPU,
                     memory, and network from the central metric catalog. -->
                <StackPanel x:Name="MetricSections" Spacing="12" />

                <Button Content="Reset defaults"
                        HorizontalAlignment="Left"
                        CornerRadius="8"
                        Click="ResetButton_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
