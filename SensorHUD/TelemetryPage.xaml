<Page
    x:Class="SensorHUD.TelemetryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!--
        Game Bar supplies the window chrome. SensorHUD owns only this
        transparent content surface and its configurable inner background.
    -->
    <Border x:Name="BackgroundPanel"
            Padding="4,0,4,4"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl x:Name="VerticalItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!--
                        One wrapping TextBlock allows every metric to use its
                        natural width. ItemsWrapGrid uses uniform cells and can
                        clip longer formatted values.
                    -->
                    <TextBlock x:Name="HorizontalText"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top" />
                </Grid>
            </ScrollViewer>

            <!-- Only failures are shown; a healthy overlay remains uncluttered. -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Margin="2,8,2,0"
                       FontSize="11"
                       Opacity="0.72"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</Page>
