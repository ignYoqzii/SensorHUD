<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Game Bar's generic system background brushes vary considerably between
        Windows versions. These small, theme-specific palettes keep nested
        settings surfaces visually related and avoid unexpectedly bright cards.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SettingsCardBackgroundBrush"
                             Color="#FF282B31" />
            <SolidColorBrush x:Key="SettingsCardBorderBrush"
                             Color="#FF454A52" />
            <SolidColorBrush x:Key="MetricCardBackgroundBrush"
                             Color="#FF32363D" />
            <SolidColorBrush x:Key="MetricCardBorderBrush"
                             Color="#FF3E434C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SettingsCardBackgroundBrush"
                             Color="#FFF5F6F8" />
            <SolidColorBrush x:Key="SettingsCardBorderBrush"
                             Color="#FFD6D9DF" />
            <SolidColorBrush x:Key="MetricCardBackgroundBrush"
                             Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MetricCardBorderBrush"
                             Color="#FFE0E3E8" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="SettingsPagePadding">20,20,20,28</Thickness>
    <Thickness x:Key="SettingsSectionPadding">18</Thickness>
    <CornerRadius x:Key="SettingsSectionCornerRadius">12</CornerRadius>

    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Padding"
                Value="{StaticResource SettingsSectionPadding}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource SettingsSectionCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush"
                Value="{ThemeResource SettingsCardBorderBrush}" />
        <Setter Property="Background"
                Value="{ThemeResource SettingsCardBackgroundBrush}" />
    </Style>
    <Style x:Key="MetricEditorCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush"
                Value="{ThemeResource MetricCardBorderBrush}" />
        <Setter Property="Background"
                Value="{ThemeResource MetricCardBackgroundBrush}" />
    </Style>
    <Style x:Key="ColorPickerFlyoutPresenterStyle"
           TargetType="FlyoutPresenter">
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.68" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ControlDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.68" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatusValueStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
