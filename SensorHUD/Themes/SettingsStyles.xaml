<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Game Bar's generic system background brushes vary considerably between
        Windows versions. These small, theme-specific palettes keep nested
        settings surfaces visually related and avoid unexpectedly bright cards.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SettingsPageBackgroundBrush" Color="#FF181A1F" />
            <SolidColorBrush x:Key="SettingsCardBackgroundBrush" Color="#EB25282E" />
            <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="MetricCardBackgroundBrush" Color="#FF2D3037" />
            <SolidColorBrush x:Key="MetricCardBorderBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="SettingsAccentBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="SettingsAccentSubtleBrush" Color="#2960CDFF" />
            <SolidColorBrush x:Key="SettingsMutedForegroundBrush" Color="#B3FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SettingsPageBackgroundBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="SettingsCardBackgroundBrush" Color="#F5FFFFFF" />
            <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="MetricCardBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MetricCardBorderBrush" Color="#18000000" />
            <SolidColorBrush x:Key="SettingsAccentBrush" Color="#FF0067C0" />
            <SolidColorBrush x:Key="SettingsAccentSubtleBrush" Color="#170067C0" />
            <SolidColorBrush x:Key="SettingsMutedForegroundBrush" Color="#A3000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="SettingsSurfaceStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource SettingsCardBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource SettingsCardBackgroundBrush}" />
    </Style>

    <Style
        x:Key="SectionCardStyle"
        BasedOn="{StaticResource SettingsSurfaceStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="MetricEditorCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource MetricCardBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource MetricCardBackgroundBrush}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SettingsMutedForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SettingsMutedForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusValueStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
